# ---- Backend ----
# Use sqlite for local dev; postgres for production (see docker-compose.yml)
DATABASE_URL=sqlite:///./skincare.db
# DATABASE_URL=postgresql+psycopg2://skincare:skincare@localhost:5432/skincare

# JWT / Auth
SECRET_KEY=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# AI configuration
AI_BACKEND=demo
AI_CONFIDENCE_THRESHOLD=0.55
# Optional: path to a real (trained) model checkpoint for the torch backend
AI_MODEL_PATH=

# Image uploads
UPLOAD_DIR=./uploads
MAX_IMAGE_BYTES=10485760

# CORS
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:12001

# App
APP_NAME=SkinCare AI
BACKEND_PORT=12000
FRONTEND_PORT=12001
